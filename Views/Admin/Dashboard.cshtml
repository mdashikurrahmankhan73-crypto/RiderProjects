@model IEnumerable<MobileShop.Models.Product>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Admin Dashboard";
    var orders = ViewBag.Orders as List<MobileShop.Models.Order> ?? new List<MobileShop.Models.Order>();
}

<div class="container-fluid bg-dark text-light min-vh-100 py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
        <div>
            <h2 class="fw-bold text-white mb-0"><i class="fa-solid fa-gauge-high text-primary me-2"></i>Admin Dashboard</h2>
            <p class="text-muted small mb-0">Manage products, inventory, and customer orders seamlessly.</p>
        </div>
        <div>
            <a asp-controller="Admin" asp-action="CreateProduct" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                <i class="fa-solid fa-plus me-2"></i>Add New Product
            </a>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card bg-secondary bg-opacity-10 border border-secondary rounded-4 p-4 text-white">
                <h6 class="text-muted text-uppercase small fw-bold">Total Products</h6>
                <h3 class="fw-bold text-info mb-0">@Model.Count()</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-secondary bg-opacity-10 border border-secondary rounded-4 p-4 text-white">
                <h6 class="text-muted text-uppercase small fw-bold">Total Orders</h6>
                <h3 class="fw-bold text-success mb-0">@orders.Count()</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-secondary bg-opacity-10 border border-secondary rounded-4 p-4 text-white">
                <h6 class="text-muted text-uppercase small fw-bold">System Status</h6>
                <h3 class="fw-bold text-warning mb-0">Active / Online</h3>
            </div>
        </div>
    </div>

    <!-- Products Management Table -->
    <div class="card bg-dark border border-secondary rounded-4 shadow-sm mb-5 p-4">
        <h4 class="fw-bold text-white mb-3">Product Inventory</h4>
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="text-secondary small text-uppercase">
                        <th>ID</th>
                        <th>Name</th>
                        <th>Model</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@item.Id</td>
                            <td>@item.Name</td>
                            <td><span class="badge bg-secondary text-light">@item.Model</span></td>
                            <td class="text-success fw-bold">৳@item.SalePrice</td>
                            <td>@item.StockQuantity</td>
                            <td class="text-end">
                                <form asp-action="DeleteProduct" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="fa-solid fa-trash me-1"></i>Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Customer Orders Table -->
    <div class="card bg-dark border border-secondary rounded-4 shadow-sm p-4">
        <h4 class="fw-bold text-white mb-3">Customer Orders (Cash on Delivery)</h4>
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr class="text-secondary small text-uppercase">
                        <th>Order ID</th>
                        <th>Customer Name</th>
                        <th>Product</th>
                        <th>Total Price</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in orders)
                    {
                        <tr>
                            <td class="fw-bold">#@order.Id</td>
                            <td>@order.CustomerName</td>
                            <td>@order.ProductName</td>
                            <td class="text-success fw-bold">৳@order.TotalPrice</td>
                            <td>@order.Phone</td>
                            <td>@order.Address</td>
                            <td><small class="text-muted">@order.OrderDate</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>