@{
    ViewData["Title"] = "Product Details - GULSHAN TECHSHOP";
}

<div class="container my-5">
    <div class="row g-5 align-items-center">
        <!-- Product Image -->
        <div class="col-md-6">
            <div class="card border-0 shadow rounded-4 overflow-hidden">
                <img src="@ViewBag.ProductImage" class="img-fluid" alt="@ViewBag.ProductName" style="height: 400px; object-fit: cover;">
            </div>
        </div>

        <!-- Product Details & Specifications -->
        <div class="col-md-6">
            <span class="badge bg-primary mb-2 px-3 py-2 rounded-pill">Official Warranty</span>
            <h1 class="fw-bold mb-3">@ViewBag.ProductName</h1>
            <h3 class="text-primary fw-bold mb-4">$@ViewBag.ProductPrice</h3>
            
            <h5 class="fw-bold mb-2">Key Specifications:</h5>
            <ul class="text-muted mb-4">
                <li>Original brand new device with international warranty.</li>
                <li>High performance processor and stunning display quality.</li>
                <li>Long battery life with fast charging support.</li>
                <li>Secure packaging and fast home delivery across Bangladesh.</li>
            </ul>

            <!-- Buy Now Button -->
            <form asp-controller="Home" asp-action="Checkout" method="get">
                <input type="hidden" name="name" value="@ViewBag.ProductName" />
                <input type="hidden" name="price" value="@ViewBag.ProductPrice" />
                <button type="submit" class="btn btn-warning btn-lg fw-bold text-dark px-5 py-3 shadow">
                    <i class="fa-solid fa-bolt me-2"></i> Buy Now
                </button>
            </form>
        </div>
    </div>
</div>