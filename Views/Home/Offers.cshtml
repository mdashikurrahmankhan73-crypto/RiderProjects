@{
    Layout = "_Layout";
    ViewData["Title"] = "Special Offers";
}

<div class="container my-5">
    <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">
        <h1 class="fw-bold text-danger mb-3"><i class="fa-solid fa-tags me-2"></i>Special Hot Deals & Offers</h1>
        <p class="lead text-muted">Discover our latest discounts, cashback offers, and festival sale items on top smartphones!</p>
        <hr class="my-4">
        <p class="text-secondary">Keep an eye on our homepage to grab the best flash sales.</p>
        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-bold">Explore Products</a>
        </div>
    </div>
</div>