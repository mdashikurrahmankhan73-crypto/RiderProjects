@{
    Layout = "_Layout";
    ViewData["Title"] = "Event";
}

<div class="container my-5">
    <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">
        <h1 class="fw-bold text-success mb-3"><i class="fa-solid fa-calendar-days me-2"></i>Upcoming Tech Events & Launches</h1>
        <p class="lead text-muted">Stay tuned for live product unboxing, flagship smartphone release events, and tech meetups.</p>
        <hr class="my-4">
        <p class="text-secondary">Subscribe to our newsletter to get event notifications.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-dark rounded-pill px-4 fw-bold">Back to Home</a>
    </div>
</div>