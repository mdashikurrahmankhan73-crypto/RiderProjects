            <div class="container h-100 d-flex align-items-center">
                <div class="text-white col-md-7 py-5">
                    <span class="badge bg-warning text-dark mb-2 px-3 py-2 rounded-pill">TECH EVENTS</span>
                    <h1 class="display-5 fw-bold text-white">Join Upcoming Tech Events</h1>
                    <p class="lead text-light">Register now for exclusive product showcases, developer workshops, and community meetups.</p>
                    <a asp-controller="Home" asp-action="Event" class="btn btn-warning btn-lg fw-bold text-dark px-4 mt-2 shadow">
