                        View Corporate Deals <i class="fa-solid fa-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Slide 4 -->
        <div class="carousel-item" style="background: linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.65)), url('https://images.unsplash.com/photo-1526738549149-8e07eca6c147?auto=format&fit=crop&w=1200&q=80'); background-size: cover; background-position: center; height: 420px;">
            <div class="container h-100 d-flex align-items-center">
