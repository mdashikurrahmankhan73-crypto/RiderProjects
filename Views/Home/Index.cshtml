            <div class="container h-100 d-flex align-items-center">
                <div class="text-white col-md-7 py-5">
                    <span class="badge bg-success mb-2 px-3 py-2 rounded-pill">NEW ARRIVALS</span>
                    <h1 class="display-5 fw-bold text-white">Latest Flagship Smartphones</h1>
