    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="p-4 border-0 shadow-sm rounded-4 bg-light h-100">
                <i class="fa-solid fa-truck-fast fa-3x text-primary mb-3"></i>
                <h5 class="fw-bold">Fast Delivery</h5>
                <p class="text-muted mb-0">Get your products delivered safely to your doorstep in record time.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 border-0 shadow-sm rounded-4 bg-light h-100">
                <i class="fa-solid fa-shield-halved fa-3x text-success mb-3"></i>
                <h5 class="fw-bold">100% Authentic</h5>
                <p class="text-muted mb-0">All products are sourced directly from official brand manufacturers.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 border-0 shadow-sm rounded-4 bg-light h-100">
                <i class="fa-solid fa-headset fa-3x text-danger mb-3"></i>
                <h5 class="fw-bold">24/7 Support</h5>
                <p class="text-muted mb-0">Our support team is always ready to assist you with your queries.</p>
            </div>
        </div>
    </div>
</div>

<!-- 3. Featured 20 Products Grid -->
<div class="container my-5" id="featured-products">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Featured Tech Products</h2>
            <p class="text-muted mb-0">Explore our wide range of gadgets and accessories</p>
        </div>
        <a asp-controller="Home" asp-action="Marketplace" class="btn btn-outline-primary fw-bold">View All Products <i class="fa-solid fa-arrow-right ms-1"></i></a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
        @for (int i = 1; i <= 20; i++)
        {
            var productNames = new string[] {
                "iPhone 15 Pro Max", "Samsung Galaxy S24 Ultra", "MacBook Pro M3", "Dell XPS 15 Laptop",
                "Sony WH-1000XM5 Headphones", "Apple Watch Series 9", "iPad Air M2", "Asus ROG Phone 8",
                "Google Pixel 8 Pro", "AirPods Pro 2nd Gen", "Logitech MX Master 3S", "Samsung Galaxy Tab S9",
                "PlayStation 5 Slim", "Xbox Series X", "Anker PowerBank 24000mAh", "JBL Charge 5 Speaker",
                "Xiaomi Smart Band 8", "Razer BlackWidow Keyboard", "Canon EOS R6 Camera", "LG UltraGear Gaming Monitor"
            };
            var prices = new decimal[] { 1199, 1299, 1599, 1499, 399, 429, 599, 999, 899, 249, 99, 799, 499, 499, 89, 179, 49, 139, 2299, 349 };
            var images = new string[] {
                "https://images.unsplash.com/photo-1592750475338-74b7b21085ab?w=400",
                "https://images.unsplash.com/photo-1610945265064-0e34e5519bbf?w=400",
                "https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=400",
                "https://images.unsplash.com/photo-1593642632823-8f785ba67e45?w=400",
                "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=400",
                "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400",
                "https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=400",
                "https://images.unsplash.com/photo-1565849904461-04a58ad377e0?w=400",
                "https://images.unsplash.com/photo-1598327105666-5b89351aff97?w=400",
                "https://images.unsplash.com/photo-1600294037681-c80b4cb5b434?w=400",
                "https://images.unsplash.com/photo-1615663245857-ac93bb7c39e7?w=400",
                "https://images.unsplash.com/photo-1585790050230-5dd28404ccb9?w=400",
                "https://images.unsplash.com/photo-1606813907291-d86efa9b94db?w=400",
                "https://images.unsplash.com/photo-1621259182978-fbf93132d53d?w=400",
                "https://images.unsplash.com/photo-1609592424009-54877797742d?w=400",
                "https://images.unsplash.com/photo-1608043152269-423dbba4e7e1?w=400",
                "https://images.unsplash.com/photo-1575311373937-040b8e1fd5b6?w=400",
                "https://images.unsplash.com/photo-1587829741301-dc798b83add3?w=400",
                "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=400",
                "https://images.unsplash.com/photo-1527443224154-c4a3942d3acf?w=400"
            };

            int index = (i - 1) % 20;

            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card">
                    <img src="@images[index]" class="card-img-top" alt="@productNames[index]" style="height: 180px; object-fit: cover;">
                    <div class="card-body d-flex flex-column p-3">
                        <span class="badge bg-light text-primary border mb-2 w-auto me-auto" style="font-size: 10px;">Official Warranty</span>
