@model IEnumerable<MobileShop.Models.Product>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Home Page - TechShop";
}

<div class="pb-5">
    <div class="position-relative bg-dark overflow-hidden mb-5" style="min-height: 350px;">
        <div class="position-absolute w-100 h-100"
             style="background-image: url('https://images.unsplash.com/photo-1531297484001-80022131f5a1?auto=format&fit=crop&w=1600&q=80'); background-size: cover; background-position: center; opacity: 0.4;">
        </div>
        <div class="container position-relative z-1 d-flex align-items-center" style="min-height: 350px;">
            <div class="text-white py-5" style="max-width: 600px;">
                <span class="badge bg-primary mb-2 px-3 py-2 text-uppercase fw-bold">Exclusive Deals</span>
                <h1 class="fw-bold display-4 mb-3">Upgrade Your Digital Lifestyle</h1>
                <p class="lead text-light mb-4">Discover top-rated smartphones, laptops, and authentic gadgets at unmissable prices.</p>
                <a href="#product-section" class="btn btn-warning fw-bold px-4 py-3 rounded-pill shadow">
                    Explore Products <i class="fa-solid fa-arrow-down ms-2"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="container my-4" id="product-section">
        <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-2">
            <div>
                <h3 class="fw-bold text-dark m-0">Featured Products</h3>
                <p class="text-muted small m-0">Top products selected for you</p>
            </div>
            <span class="badge bg-dark px-3 py-2 fs-6">20 Items Available</span>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden product-card bg-white">
                            <div class="bg-light p-3 text-center position-relative d-flex align-items-center justify-content-center" style="height: 190px;">
                                <img src="@item.MainImageUrl" class="img-fluid h-100" style="object-fit: contain;" alt="@item.Name" />
                            </div>
                            <div class="card-body d-flex flex-column justify-content-between p-3">
                                <div>
                                    <span class="text-uppercase text-muted fw-bold d-block mb-1" style="font-size: 0.7rem;">@item.Model</span>
                                    <h6 class="fw-bold text-dark text-truncate mb-2">@item.Name</h6>
                                </div>
                                <div class="mt-2">
                                    <div class="mb-3">
                                        <span class="fw-bold text-dark fs-5">৳@item.SalePrice</span>
                                    </div>
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id" 
                                       class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-bold py-2 shadow-sm d-flex align-items-center justify-content-center gap-1">
                                        <i class="fa-regular fa-eye"></i> View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                @for (int i = 1; i <= 20; i++)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden product-card bg-white">
                            <div class="bg-light p-3 text-center position-relative d-flex align-items-center justify-content-center" style="height: 190px;">
                                <img src="https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?auto=format&fit=crop&w=400&q=80" class="img-fluid h-100" style="object-fit: contain;" alt="Sample" />
                            </div>
                            <div class="card-body d-flex flex-column justify-content-between p-3">
                                <div>
                                    <span class="text-uppercase text-muted fw-bold d-block mb-1" style="font-size: 0.7rem;">Tech Device</span>
                                    <h6 class="fw-bold text-dark text-truncate mb-2">Smart Gadget Model @i</h6>
                                </div>
                                <div class="mt-2">
                                    <div class="mb-3">
                                        <span class="fw-bold text-dark fs-5">৳@(25000 + (i * 1200))</span>
                                    </div>
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@i" 
                                       class="btn btn-outline-primary btn-sm w-100 rounded-pill fw-bold py-2 shadow-sm d-flex align-items-center justify-content-center gap-1">
                                        <i class="fa-regular fa-eye"></i> View Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    .product-card { transition: transform 0.25s ease, box-shadow 0.25s ease; }
    .product-card:hover { transform: translateY(-5px); box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,0.1) !important; }
</style>