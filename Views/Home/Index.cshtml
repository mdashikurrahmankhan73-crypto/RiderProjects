                        <div class="text-warning mb-2" style="font-size: 12px;">
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star-half-stroke"></i>
                            <span class="text-muted ms-1">(4.8)</span>
                        </div>
                        <h5 class="fw-bold text-primary mb-3">$@prices[index]</h5>
                        
                        <!-- Add to Cart & Buy Now Buttons -->
                        <div class="mt-auto d-flex flex-column gap-2">
                            <button type="button" class="btn btn-primary btn-sm fw-bold w-100 py-2 add-to-cart-btn" 
                                    data-name="@productNames[index]" data-price="@prices[index]" data-img="@images[index]">
                                <i class="fa-solid fa-cart-plus me-1"></i> Add to Cart
                            </button>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-warning btn-sm fw-bold text-dark w-100 py-2">
                                <i class="fa-solid fa-bolt me-1"></i> Buy Now
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Right Side Automatic Cart Offcanvas Sidebar -->
<div class="offcanvas offcanvas-end shadow-lg" tabindex="-1" id="cartOffcanvas" aria-labelledby="cartOffcanvasLabel">
    <div class="offcanvas-header bg-primary text-white">
        <h5 class="offcanvas-title fw-bold" id="cartOffcanvasLabel">
            <i class="fa-solid fa-cart-shopping me-2"></i> Your Cart (<span id="cartCount">0</span>)
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column">
        <!-- Cart Items List Container -->
        <div id="cartItemsList" class="flex-grow-1 overflow-auto mb-3">
            <div class="text-center text-muted py-5" id="emptyCartMessage">
                <i class="fa-solid fa-basket-shopping fa-3x mb-3 text-secondary"></i>
                <p>Your cart is currently empty.</p>
            </div>
        </div>

        <!-- Cart Summary & Buy Now Section -->
        <div class="border-top pt-3">
            <div class="d-flex justify-content-between mb-3 fs-5 fw-bold">
                <span>Total:</span>
                <span id="cartTotalPrice" class="text-primary">$0.00</span>
            </div>
            <div class="d-grid gap-2">
                <a asp-controller="Account" asp-action="Login" class="btn btn-warning btn-lg fw-bold text-dark py-2 shadow-sm">
                    <i class="fa-solid fa-bag-shopping me-2"></i> Buy Now (Checkout)
                </a>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="offcanvas">Continue Shopping</button>
            </div>
        </div>
    </div>
</div>

<!-- JavaScript for Add to Cart & Offcanvas Interaction -->
@section Scripts {
    <script>
        let cart = [];

        document.querySelectorAll('.add-to-cart-btn').forEach(button => {
            button.addEventListener('click', function () {
                const name = this.getAttribute('data-name');
                const price = parseFloat(this.getAttribute('data-price'));
                const img = this.getAttribute('data-img');

                // Check if product already exists in cart
                const existingItem = cart.find(item => item.name === name);
                if (existingItem) {
                    existingItem.quantity += 1;
                } else {
                    cart.push({ name, price, img, quantity: 1 });
                }

                updateCartUI();

                // Open the right-side cart offcanvas automatically
                const cartOffcanvasElement = document.getElementById('cartOffcanvas');
                const cartOffcanvas = bootstrap.Offcanvas.getOrCreateInstance(cartOffcanvasElement);
                cartOffcanvas.show();
            });
        });

        function updateCartUI() {
            const cartItemsList = document.getElementById('cartItemsList');
            const cartCount = document.getElementById('cartCount');
            const cartTotalPrice = document.getElementById('cartTotalPrice');

            cartCount.innerText = cart.reduce((sum, item) => sum + item.quantity, 0);

            if (cart.length === 0) {
                cartItemsList.innerHTML = `
                    <div class="text-center text-muted py-5">
                        <i class="fa-solid fa-basket-shopping fa-3x mb-3 text-secondary"></i>
                        <p>Your cart is currently empty.</p>
                    </div>`;
                cartTotalPrice.innerText = '$0.00';
                return;
            }

            let html = '';
            let total = 0;

            cart.forEach((item, index) => {
                total += item.price * item.quantity;
                html += `
                    <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                        <img src="${item.img}" class="rounded me-3" style="width: 60px; height: 60px; object-fit: cover;">
                        <div class="flex-grow-1">
                            <h6 class="fw-bold mb-1 text-truncate" style="max-width: 150px;">${item.name}</h6>
                            <p class="small text-muted mb-0">$${item.price} x ${item.quantity}</p>
                        </div>
                        <button class="btn btn-sm text-danger" onclick="removeItem(${index})"><i class="fa-solid fa-trash"></i></button>
                    </div>`;
            });

            cartItemsList.innerHTML = html;
            cartTotalPrice.innerText = `$${total.toFixed(2)}`;
        }

        function removeItem(index) {
            cart.splice(index, 1);
            updateCartUI();
        }
    </script>
}