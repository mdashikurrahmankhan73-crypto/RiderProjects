@{
    ViewData["Title"] = "Checkout - GULSHAN TECHSHOP";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card border-0 shadow-lg rounded-4 p-4">
                <h3 class="fw-bold mb-3 text-primary"><i class="fa-solid fa-address-card me-2"></i>Customer Information</h3>
                <p class="text-muted mb-4">Please fill up your delivery details to complete the order.</p>

                <form id="checkoutForm" asp-controller="Home" asp-action="OrderSuccess" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Customer Name</label>
                        <input type="text" name="FullName" class="form-control form-control-lg" placeholder="Md. Ashikur Rahman" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mobile Number</label>
                        <input type="tel" name="Phone" class="form-control form-control-lg" placeholder="017xxxxxxxx" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Customer Address</label>
                        <textarea name="Address" class="form-control" rows="3" placeholder="House, Road, Area, City" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Zip Code</label>
                        <input type="text" name="ZipCode" class="form-control form-control-lg" placeholder="1212" required />
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-success btn-lg fw-bold py-3 shadow">
                            <i class="fa-solid fa-truck-fast me-2"></i> Cash on Delivery
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const currentUserEmail = '@Context.Session.GetString("UserEmail")' || 'guest';

        document.getElementById('checkoutForm').addEventListener('submit', function () {
            // Get current cart items from localStorage
            let cart = JSON.parse(localStorage.getItem('techShopCart')) || [];
            
            // Unique storage key based on logged-in user email
            const storageKey = 'techShopOrders_' + currentUserEmail;
            let userOrders = JSON.parse(localStorage.getItem(storageKey)) || [];

            // Add new ordered items to specific user's order history
            if (cart.length > 0) {
                cart.forEach(item => {
                    let randomId = "#GTS-" + Math.floor(10000 + Math.random() * 90000);
                    userOrders.unshift({
                        id: randomId,
                        name: item.name,
                        img: item.img,
                        price: item.price,
                        qty: item.quantity,
                        method: "Cash on Delivery",
                        status: "Processing"
                    });
                });
            } else {
                // Fallback item if cart was somehow empty during submit
                let randomId = "#GTS-" + Math.floor(10000 + Math.random() * 90000);
                userOrders.unshift({
                    id: randomId,
                    name: "MacBook Pro M3",
                    img: "https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=400",
                    price: 1599.00,
                    qty: 1,
                    method: "Cash on Delivery",
                    status: "Processing"
                });
            }

            // Save back to user-specific localStorage key
            localStorage.setItem(storageKey, JSON.stringify(userOrders));

            // Clear the cart after successful checkout placement
            localStorage.removeItem('techShopCart');
        });
    </script>
}