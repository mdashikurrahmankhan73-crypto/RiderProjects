@model MobileShop.Models.Product

@{
    Layout = "_Layout";
    ViewData["Title"] = "Checkout";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow border-0 rounded-4 p-4 bg-white">
                <h3 class="fw-bold mb-3 text-primary"><i class="fa-solid fa-bag-shopping me-2"></i>Checkout Details</h3>
                <hr />
                
                <div class="d-flex align-items-center mb-4 p-3 bg-light rounded-3">
                    <img src="@Model.MainImageUrl" style="width: 70px; height: 70px; object-fit: contain;" class="me-3" />
                    <div>
                        <h6 class="fw-bold mb-1">@Model.Name</h6>
                        <span class="text-danger fw-bold">৳@(Model.SalePrice > 0 ? Model.SalePrice : Model.OriginalPrice)</span>
                    </div>
                </div>

                <form asp-action="PlaceOrder" method="post">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Full Name</label>
                        <input type="text" name="customerName" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Phone Number</label>
                        <input type="text" name="phone" class="form-control rounded-3" placeholder="017xxxxxxxx" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Delivery Address</label>
                        <textarea name="address" class="form-control rounded-3" rows="2" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Zip Code / Postal Code</label>
                        <input type="text" name="zipCode" class="form-control rounded-3" required />
                    </div>
                    
                    <div class="mb-3 p-3 bg-light rounded-3 border">
                        <span class="fw-bold text-success"><i class="fa-solid fa-money-bill-wave me-2"></i>Payment Method: Cash on Delivery (COD)</span>
                    </div>

                    <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold py-3 shadow">
                        Confirm & Place Order
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>