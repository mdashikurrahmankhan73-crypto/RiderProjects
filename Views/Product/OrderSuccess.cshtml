@model MobileShop.Models.Order
@{
    Layout = "_Layout";
    ViewData["Title"] = "Order Success";
}

<div class="container my-5 text-center">
    <div class="card border-0 shadow-sm rounded-4 p-5 bg-white mx-auto" style="max-width: 600px;">
        <div class="mb-4">
            <i class="fa-solid fa-circle-check text-success display-1"></i>
        </div>
        <h2 class="fw-bold text-success mb-2">Order Placed Successfully!</h2>
        <p class="text-muted mb-4">Thank you, <strong>@Model.CustomerName</strong>. Your Cash on Delivery order has been confirmed.</p>
        
        <div class="bg-light p-3 rounded-3 text-start mb-4">
            <p class="mb-1"><strong>Order ID:</strong> #@Model.Id</p>
            <p class="mb-1"><strong>Product Name:</strong> @Model.ProductName</p>
            <p class="mb-1"><strong>Total Amount:</strong> ৳@Model.TotalPrice</p>
            <p class="mb-0"><strong>Delivery Address:</strong> @Model.Address, @Model.ZipCode</p>
        </div>

        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-5 fw-bold">
                <i class="fa-solid fa-arrow-left me-2"></i>Back to Home
            </a>
        </div>
    </div>
</div>